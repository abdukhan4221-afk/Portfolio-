# Supabase project settings. Keep the service-role key private.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Set the password you chose for the admin login. This value stays server-side.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Generate a long random value (at least 32 characters). Never expose it in frontend code.
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
